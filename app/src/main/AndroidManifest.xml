<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="io.hammerhead.sensorservice" />
    </queries>

    <application
        android:icon="@drawable/ic_light"
        android:label="@string/app_name">

        <service
            android:name=".VariaExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

        <receiver
            android:name=".LightCommandReceiver"
            android:exported="false" />
    </application>
</manifest>
